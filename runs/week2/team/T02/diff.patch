+    def search(self, query: str) -> list[Task]:
+        """Return live tasks whose title contains query, casefolded.
+
+        The query is not stripped. An empty query matches every task.
+        Non-string queries raise ValueError. Nothing is mutated.
+        """
+        if not isinstance(query, str):
+            raise ValueError("Query must be a string")
+        needle = query.casefold()
+        return [
+            task for task in self._tasks.values() if needle in task.title.casefold()
+        ]
 
