+    def to_csv(self) -> str:
+        """Return tasks as CSV text without modifying the store."""
+        buffer = io.StringIO(newline="")
+        writer = csv.writer(buffer, lineterminator="\n")
+        writer.writerow(["id", "title", "priority", "completed"])
+        for task in self._tasks.values():
+            writer.writerow(
+                [
+                    task.id,
+                    task.title,
+                    task.priority,
+                    "true" if task.completed else "false",
+                ]
+            )
+        return buffer.getvalue()
