+    def to_csv(self) -> str:
+        """Return all tasks as CSV text in creation order, without mutation."""
+        import csv
+        import io
+
+        out = io.StringIO(newline="")
+        writer = csv.writer(
+            out, delimiter=",", quotechar='"', lineterminator="\n",
+            quoting=csv.QUOTE_MINIMAL,
+        )
+        writer.writerow(["id", "title", "priority", "completed"])
+        for task in self._tasks.values():
+            writer.writerow([
+                task.id,
+                task.title,
+                task.priority,
+                "true" if task.completed else "false",
+            ])
+        return out.getvalue()
