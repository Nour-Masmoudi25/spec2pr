+    def to_csv(self) -> str:
+        """Return tasks as CSV text (header plus one row per task, \\n ends)."""
+
+        def quote(value: object) -> str:
+            text = str(value)
+            if any(ch in text for ch in ',"\r\n'):
+                text = '"' + text.replace('"', '""') + '"'
+            return text
+
+        lines = ["id,title,priority,completed\n"]
+        for task in self._tasks.values():
+            done = "true" if task.completed else "false"
+            lines.append(
+                ",".join(
+                    [quote(task.id), quote(task.title), quote(task.priority), done]
+                )
+                + "\n"
+            )
+        return "".join(lines)
+
