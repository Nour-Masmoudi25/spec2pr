{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec",
  "type": "object",
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "budget_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "spec_id",
    "description",
    "acs",
    "allowed_paths",
    "budget_usd"
  ],
  "additionalProperties": false
}
