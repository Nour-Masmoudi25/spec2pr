{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test_plan",
  "type": "object",
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ac_map": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^AC-[1-9][0-9]*$": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "spec_id",
    "test_ids",
    "ac_map"
  ],
  "additionalProperties": false
}
