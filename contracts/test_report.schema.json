{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test_report",
  "type": "object",
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "f2p": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pass",
        "fail"
      ],
      "additionalProperties": false
    },
    "p2p": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pass",
        "fail"
      ],
      "additionalProperties": false
    },
    "lint": {
      "enum": [
        "passed",
        "failed",
        "not_run"
      ]
    }
  },
  "required": [
    "spec_id",
    "f2p",
    "p2p",
    "lint"
  ],
  "additionalProperties": false
}
