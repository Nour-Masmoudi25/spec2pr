{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "type": "object",
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "verdict": {
      "enum": [
        "approve",
        "request_changes"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "ac": {
            "type": "string",
            "pattern": "^AC-[1-9][0-9]*$"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "file",
          "line",
          "ac",
          "severity",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "spec_id",
    "verdict",
    "findings"
  ],
  "additionalProperties": false
}
