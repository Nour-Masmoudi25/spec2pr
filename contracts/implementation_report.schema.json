{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "implementation_report",
  "type": "object",
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "diff_stat": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "added": {
            "type": "integer",
            "minimum": 0
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "file",
          "added",
          "removed"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "spec_id",
    "task_id",
    "diff_stat",
    "notes"
  ],
  "additionalProperties": false
}
