+def dumps_store(store: TaskStore) -> str:
+    """Serialize validated data without opening files."""
+    if not isinstance(store, TaskStore):
+        raise ValueError("Store must be a TaskStore")
+    return json.dumps(store._snapshot(), ensure_ascii=False, indent=2, allow_nan=False)
+
+
+def loads_store(text: str) -> TaskStore:
+    """Decode a JSON string using the file format's strict validation."""
+    if not isinstance(text, str):
+        raise ValueError("JSON text must be a string")
+    return _decode_document(json.loads(text, object_pairs_hook=_unique_object, parse_constant=_reject_constant))
